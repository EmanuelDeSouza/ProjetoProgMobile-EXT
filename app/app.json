{
  "expo": {
    "name": "CuidaLar",
    "slug": "cuidalar",
    "scheme": "cuidalar",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAFAF8",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.cuidalar"
    },
    "android": {
      "package": "com.anonymous.cuidalar",
      "permissions": ["POST_NOTIFICATIONS", "VIBRATE"]
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#0F6B5C"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
