# Copie para .env e troque pelo IP do seu PC na rede Wi-Fi (ipconfig no Windows / ip a no Linux).
# Celular físico não enxerga "localhost" do PC. Emulador Android: http://10.0.2.2:3000/v1
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000/v1

# Login com Google (opcional). Sem estes valores o botão "Continuar com Google" não aparece.
# Os mesmos IDs vão em GOOGLE_CLIENT_IDS no api/.env.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
