PORT=3000
DATABASE_URL=postgres://cuidalar:cuidalar@localhost:5432/cuidalar
# Gere um segredo longo em produção: openssl rand -hex 32
JWT_SECRET=dev-only-jwt-secret-cuidalar-troque-em-producao-32+

# Broker MQTT (Mosquitto com dynamic security — ver mosquitto/config/mosquitto.conf)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=cuidalar-api
MQTT_PASSWORD=cuidalar-dev
# Usuário compartilhado gravado no firmware, só para anunciar o código de pareamento
MQTT_PROVISIONING_USERNAME=provisionamento
MQTT_PROVISIONING_PASSWORD=provisionamento-dev
MQTT_DYNSEC=true

# Login com Google (opcional): client IDs OAuth (web, android, ios) separados por vírgula
GOOGLE_CLIENT_IDS=

# Fuso das regras de horário (RF-12)
APP_TIMEZONE=America/Sao_Paulo

# true = não chama a Expo Push API (útil sem internet)
MOCK_PUSH=false
