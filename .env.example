# Copie para .env (na raiz, ao lado do docker-compose.yml) só se precisar mudar algo.
# Portas no seu PC. Mude se já tiver Postgres/Mosquitto instalados no Windows:
#   POSTGRES_PORT=5433  →  api/.env: DATABASE_URL=postgres://cuidalar:cuidalar@localhost:5433/cuidalar
#   MQTT_PORT=1884      →  api/.env: MQTT_BROKER_URL=mqtt://localhost:1884
POSTGRES_PORT=5432
MQTT_PORT=1883
MQTT_TLS_PORT=8883

# Admin do broker (tem de bater com MQTT_USERNAME / MQTT_PASSWORD de api/.env)
MQTT_ADMIN_USER=cuidalar-api
MQTT_ADMIN_PASSWORD=cuidalar-dev
